[mysqld]
# Unicode everywhere.
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci

# Why: ttl64 nodes are small (2 GB); these keep MySQL near 300 MB at rest.
innodb_buffer_pool_size = 128M
innodb_log_buffer_size = 8M
performance_schema = OFF
max_connections = 100
table_open_cache = 400

# Clients reach it by Service name; skip reverse DNS on every connection.
skip-name-resolve

# MySQL creates its own TLS certificate on first start; require at least TLS 1.2.
tls_version = TLSv1.2,TLSv1.3
